# Settings for the server. Every one is optional and has the default shown here.
# Copy this file to .env for local development.

# Port the server listens on.
PORT=3000

# fatal, error, warn, info, debug, trace or silent.
LOG_LEVEL=info

# How many proxies sit in front of the server. Leave at 0 unless it runs behind a
# proxy or load balancer, where it must match the number of proxies.
TRUSTED_PROXY_COUNT=0

# Upload rate limit: at most RATE_LIMIT_MAX requests per visitor in each window.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=10

# Where the built client is. Leave empty for client/dist, which `npm run build` creates.
# The server serves the API only when the folder is missing, as in development.
CLIENT_DIR=
